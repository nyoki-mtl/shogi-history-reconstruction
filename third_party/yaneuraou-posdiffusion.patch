+
+extern "C" {
+
+int yaneuraou_returnable_init() {
+    Bitboards::init();
+    Position::init();
+    return 0;
+}
+
+int yaneuraou_returnable_mask(const int* predicted, const int* source, int batch, int use_light_checks, uint8_t* out) {
+    if (!predicted || !source || !out || batch <= 0) {
+        return -1;
+    }
+
+    for (int idx = 0; idx < batch; ++idx) {
+        const int* prev_tokens = predicted + idx * kTotalTokens;
+        const int* curr_tokens = source + idx * kTotalTokens;
+        out[idx] = 0;
+        if (find_returnable_move(prev_tokens, curr_tokens, use_light_checks != 0, nullptr)) {
+            out[idx] = 1;
+        }
+    }
+    return 0;
+}
+
+int yaneuraou_returnable_usi(
+    const int* predicted,
+    const int* source,
+    int batch,
+    int use_light_checks,
+    char* out,
+    int stride
+) {
+    if (!predicted || !source || !out || batch <= 0 || stride <= 0) {
+        return -1;
+    }
+    for (int idx = 0; idx < batch; ++idx) {
+        char* slot = out + idx * stride;
+        slot[0] = '\0';
+        std::string mv_usi;
+        if (find_returnable_move(
+                predicted + idx * kTotalTokens,
+                source + idx * kTotalTokens,
+                use_light_checks != 0,
+                &mv_usi
+            )) {
+            std::strncpy(slot, mv_usi.c_str(), static_cast<size_t>(stride - 1));
+            slot[stride - 1] = '\0';
+        }
+    }
+    return 0;
+}
+
+int yaneuraou_generate_predecessors(
+    const int* source,
+    int max_candidates,
+    int* out_tokens,
+    char* out_usi,
+    int usi_stride,
+    int* out_kind,
+    int* out_from,
+    int* out_to,
+    int* out_moved,
+    int* out_captured,
+    uint8_t* out_promoted,
+    int* out_count
+) {
+    if (!source || max_candidates <= 0 || !out_tokens || !out_usi || usi_stride <= 0 || !out_kind || !out_from
+        || !out_to || !out_moved || !out_captured || !out_promoted || !out_count) {
+        return -1;
+    }
+
+    std::vector<CandidateDraft> drafts = enumerate_predecessor_drafts(source);
+    int count = 0;
+    for (const CandidateDraft& draft : drafts) {
+        if (count >= max_candidates) {
+            return -2;
+        }
+        std::string move_usi;
+        if (!find_returnable_move(draft.tokens.data(), source, true, &move_usi)) {
+            continue;
+        }
+
+        int* token_slot = out_tokens + count * kTotalTokens;
+        for (int idx = 0; idx < kTotalTokens; ++idx) {
+            token_slot[idx] = draft.tokens[idx];
+        }
+
+        char* usi_slot = out_usi + count * usi_stride;
+        usi_slot[0] = '\0';
+        std::strncpy(usi_slot, move_usi.c_str(), static_cast<size_t>(usi_stride - 1));
+        usi_slot[usi_stride - 1] = '\0';
+
+        out_kind[count] = draft.kind;
+        out_from[count] = draft.from_square;
+        out_to[count] = draft.to_square;
+        out_moved[count] = draft.moved_piece;
+        out_captured[count] = draft.captured_piece;
+        out_promoted[count] = draft.promoted;
+        ++count;
+    }
+    *out_count = count;
+    return 0;
+}
+
+}  // extern "C"
