+
+UnitTester::UnitTester() = default;
+
+UnitTester::~UnitTester() = default;
+
+void UnitTester::test(const std::string& /*message*/, bool /*b*/) {
+    ++test_count;
+}
+
+void UnitTester::run(std::function<void(UnitTester&, IEngine&)> f) {
+    if (before_run) {
+        before_run();
+    }
+    f(*this, *engine);
+    if (after_run) {
+        after_run();
+    }
+}
+
+const std::string UnitTester::section_name() {
+    std::stringstream ss;
+    ss << "[";
+    bool first = true;
+    for (const auto& section : sections) {
+        if (!first) {
+            ss << "::";
+        }
+        first = false;
+        ss << section;
+    }
+    ss << "]";
+    return ss.str();
+}
+
+void UnitTest(std::istringstream& /*is*/, IEngine& /*engine*/) {}
+
+}  // namespace Test
